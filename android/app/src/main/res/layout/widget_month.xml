<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 '이번 달' 위젯: 왼쪽 월·운동일·연속, 오른쪽 3D 달력 타일 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/sw_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/sw_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_brand"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sw_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_sub"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sw_btn_log"
                android:layout_width="84dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_primary"
                android:gravity="center"
                android:text="@string/widget_btn_log"
                android:textColor="@color/widget_on_brand"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/sw_chart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_month_title"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
